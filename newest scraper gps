# ---------------- Pomocné I/O ----------------
def _today_str():
    return date.today().isoformat()

def _parse_date(s):
    try:
        return datetime.strptime(str(s)[:10], "%Y-%m-%d").date()
    except:
        return None

def _read_xlsx(path, **kw):
    if os.path.exists(path):
        try:
            return pd.read_excel(path, **kw)
        except:
            pass
    return pd.DataFrame()

def _write_xlsx(df: pd.DataFrame, path: str):
    tmp = path + ".tmp.xlsx"
    with pd.ExcelWriter(tmp, engine="openpyxl") as w:
        df.to_excel(w, index=False)
    os.replace(tmp, path)

def _latest_fact_path():
    today = os.path.join(FACT_DAY_DIR, f"{_today_str()}.xlsx")
    if os.path.exists(today):
        return today
    # fallback: zober najnovší súbor vo fact_daily
    files = [os.path.join(FACT_DAY_DIR, f) for f in os.listdir(FACT_DAY_DIR) if f.endswith(".xlsx")]
    if not files:
        return None
    return max(files, key=os.path.getmtime)

# ---------------- Výber práce z DIM + FACT ----------------
def prepare_work_from_fact_and_gps():
    fact_path = _latest_fact_path()
    if not fact_path:
        raise FileNotFoundError(f"V priečinku {FACT_DAY_DIR} som nenašiel žiadny fact_daily XLSX.")

    fact = _read_xlsx(fact_path)
    # očakávané stĺpce z všeobecného scraperu
    # obs_date | listing_id | status | price | property_type_observed | reserved_or_sold_flag | title | url
    needed_cols = {"listing_id","url","status","obs_date"}
    missing = needed_cols - set(fact.columns)
    if missing:
        raise ValueError(f"Vo {fact_path} chýbajú stĺpce: {missing}")

    # ber iba tie, kde máme URL a ID
    fact = fact.dropna(subset=["listing_id","url"])
    fact["listing_id"] = fact["listing_id"].astype(str)

    # vyber dnešné aktívne + rezervované (sold nemá zmysel)
    # ak používaš iné statusy, uprav si filter
    today_str = _today_str()
    today_rows = fact[fact["obs_date"].astype(str).str[:10] == today_str]
    if today_rows.empty:
        # ak dnešný fact nie je, použijeme najnovší dostupný (už vybraný v _latest_fact_path)
        today_rows = fact.copy()

    today_rows = today_rows[today_rows["status"].isin(["active","reserved"])]
    today_rows = today_rows[["listing_id","url"]].drop_duplicates()

    # načítaj gps_dim (kartotéka)
    gps = _read_xlsx(GPS_DIM_PATH)
    if gps.empty:
        gps = pd.DataFrame(columns=["listing_id","url","lat","lng","source","quality","grabbed_at","attempts","last_attempt_at"])

    # normalizuj typy a defaulty
    gps["listing_id"] = gps["listing_id"].astype(str) if "listing_id" in gps.columns else pd.Series([], dtype=str)
    for c in ["lat","lng"]:
        if c not in gps.columns: gps[c] = None
    for c in ["source","quality"]:
        if c not in gps.columns: gps[c] = None
    for c in ["grabbed_at","last_attempt_at"]:
        if c not in gps.columns: gps[c] = None
    if "attempts" not in gps.columns:
        gps["attempts"] = 0

    # pomocné sety/mapy
    have_exact = set(gps.loc[gps["lat"].notna() & gps["lng"].notna(), "listing_id"].astype(str))

    # approx kandidáti (revalidácia)
    approx_mask = gps["quality"].isin(["approx_circle","approx_center"])
    approx_old = []
    if approx_mask.any():
        dt_col = gps["grabbed_at"].apply(_parse_date)
        mask_old = approx_mask & dt_col.apply(lambda d: (d is None) or ((date.today() - d).days >= REVALIDATE_APPROX_AFTER_DAYS))
        approx_old = gps.loc[mask_old, "listing_id"].astype(str).tolist()

    # retry kandidáti: bez GPS, attempts < RETRY_MAX, cooldown >= RETRY_COOLDOWN_DAYS
    retry_ids = []
    if not gps.empty:
        no_gps = gps["lat"].isna() | gps["lng"].isna()
        if no_gps.any():
            attempts_ok = gps["attempts"].fillna(0) < RETRY_MAX_ATTEMPTS
            last_attempt_ok = gps["last_attempt_at"].apply(_parse_date).apply(
                lambda d: (d is None) or ((date.today() - d).days >= RETRY_COOLDOWN_DAYS)
            )
            retry_ids = gps.loc[no_gps & attempts_ok & last_attempt_ok, "listing_id"].astype(str).tolist()

    # NEW: v dnešnom zozname, ale nie v have_exact
    today_ids = set(today_rows["listing_id"].astype(str))
    new_ids = sorted(today_ids - have_exact)

    # revalidácie + retry musia byť zároveň v dnešnom zozname (aby sme neskúšali zbytočne neaktuálne inzeráty)
    approx_ids = sorted(set(approx_old) & today_ids)
    retry_ids  = sorted(set(retry_ids) & today_ids)

    # poradie: NEW -> RETRY -> APPROX (môžeš si upraviť)
    work_ids = []
    for block in [new_ids, retry_ids, approx_ids]:
        for lid in block:
            if lid not in work_ids:
                work_ids.append(lid)

    # pripoj URL
    id_to_url = dict(zip(today_rows["listing_id"], today_rows["url"]))
    work = [{"listing_id": lid, "url": id_to_url.get(lid, "")} for lid in work_ids if id_to_url.get(lid)]
    return work, gps, fact_path

# ---------------- Kvalita zdroja ----------------
def classify_quality(source: str):
    s = (source or "").lower()
    if s.startswith("inline:l.marker") or "marker" in s or "leaflet:object" in s:
        return "exact_marker"
    if "setview" in s:
        return "exact_setview"
    if "xhr-sniffer" in s:
        return "exact_api"
    if "iframe-@" in s or "iframe-q" in s or "iframe-ll" in s:
        return "exact_url"
    if "circle" in s:
        return "approx_circle"
    if "dom:center-transform" in s:
        return "approx_center"
    # fallback
    return "unknown"

# ---------------- Scraper jadro (hook + fallbacky) ----------------
LEAFLET_HOOK = r"""
(() => {
  const fnum = v => { if (v == null) return null; const n = parseFloat(String(v).replace(',', '.')); return Number.isFinite(n) ? n : null; };
  const push = (tag, ll) => {
    try {
      const lat = fnum(ll?.lat ?? ll?.latlng?.lat ?? (Array.isArray(ll) ? ll[0] : null));
      const lng = fnum(ll?.lng ?? ll?.lon ?? ll?.long ?? ll?.latlng?.lng ?? (Array.isArray(ll) ? ll[1] : null));
      if (lat != null && lng != null) {
        window.__leafletGps = window.__leafletGps || [];
        window.__leafletGps.push({ tag, lat, lng, t: Date.now() });
      }
    } catch(e){}
  };

  function patchOnce() {
    try {
      if (!window.L || !window.L.Map || window.__leafletPatched) return !!window.__leafletPatched;
      window.__leafletPatched = true;

      const M = L.Map.prototype;
      const _setView   = M.setView;   M.setView   = function(c,z,o){ push('setView', c);  return _setView.call(this,c,z,o); };
      const _panTo     = M.panTo;     M.panTo     = function(c,o){   push('panTo', c);    return _panTo.call(this,c,o); };
      const _fitBounds = M.fitBounds; M.fitBounds = function(b,o){
        try{
          const sw = b?.getSouthWest ? b.getSouthWest() : b?.[0];
          const ne = b?.getNorthEast ? b.getNorthEast() : b?.[1];
          const lat = (fnum(sw?.lat ?? sw?.[0]) + fnum(ne?.lat ?? ne?.[0]))/2;
          const lng = (fnum(sw?.lng ?? sw?.lon ?? sw?.[1]) + fnum(ne?.lng ?? ne?.lon ?? ne?.[1]))/2;
          if (Number.isFinite(lat) && Number.isFinite(lng)) push('fitBounds-center', {lat, lng});
        }catch(e){}
        return _fitBounds.call(this,b,o);
      };

      if (L.marker) { const _m=L.marker; L.marker=function(ll,opt){ push('marker', ll); return _m.call(this,ll,opt); }; }
      if (L.circle) { const _c=L.circle; L.circle=function(ll,r,opt){ push('circle', ll); return _c.call(this,ll,r,opt); }; }

      if (L.Marker && L.Marker.prototype.setLatLng) {
        const _sl = L.Marker.prototype.setLatLng;
        L.Marker.prototype.setLatLng = function (ll) { push('marker.setLatLng', ll); return _sl.call(this, ll); };
      }

      if (L.Map && L.Map.prototype.addLayer) {
        const _al = L.Map.prototype.addLayer;
        L.Map.prototype.addLayer = function(layer){
          try { if (layer && typeof layer.getLatLng === 'function') push('map.addLayer(marker)', layer.getLatLng()); } catch(e){}
          return _al.call(this, layer);
        };
      }

      const MCG = L.MarkerClusterGroup || (L.MarkerCluster && L.MarkerClusterGroup);
      if (MCG && MCG.prototype && MCG.prototype.addLayers) {
        const _add = MCG.prototype.addLayers;
        MCG.prototype.addLayers = function(layers){
          try {
            (layers || []).forEach(l => {
              try { if (l && typeof l.getLatLng === 'function') push('cluster.add', l.getLatLng()); } catch(e){}
            });
          } catch(e){}
          return _add.call(this, layers);
        };
      }

      if (L.geoJSON) {
        const _g=L.geoJSON;
        L.geoJSON=function(data,opt){
          try {
            const arr = Array.isArray(data) ? data : (data && data.features) || [];
            for (const f of arr) {
              const g = f && f.geometry;
              if (g && g.type === 'Point' && Array.isArray(g.coordinates) && g.coordinates.length >= 2) {
                push('geojson-point', { lat: g.coordinates[1], lng: g.coordinates[0] });
              }
            }
          }catch(e){}
          return _g.call(this,data,opt);
        };
        L.geoJson = L.geoJSON;
      }
    } catch(e){}
    return true;
  }
  if (!patchOnce()) {
    const id = setInterval(() => { if (patchOnce()) clearInterval(id); }, 30);
  }
})();
"""

GMAPS_AT  = re.compile(r'@\s*(-?\d{1,2}(?:[.,]\d+)?)\s*,\s*(-?\d{1,3}(?:[.,]\d+)?)\s*,\s*\d+z', re.I)
LATLNG_RE = re.compile(r'\b(4[6-9]|5[0-4])\.\d{3,7}\s*,\s*(1[0-9]|2[0-9])\.\d{3,7}\b')

def _to_float(x):
    try: return float(str(x).replace(",", "."))
    except: return None

def valid_coord(lat, lng) -> bool:
    try:
        lat = _to_float(lat); lng = _to_float(lng)
        return (lat is not None and lng is not None and 45.0 <= lat <= 55.0 and 10.0 <= lng <= 30.0)
    except:
        return False

def coords_from_url_string(url: str):
    if not url: return None
    m = GMAPS_AT.search(url)
    if m and valid_coord(m.group(1), m.group(2)):
        return round(_to_float(m.group(1)),6), round(_to_float(m.group(2)),6), "iframe-@"
    try:
        u = urlparse(url); q = parse_qs(u.query)
        lat = q.get("lat") or q.get("latitude")
        lng = q.get("lng") or q.get("lon") or q.get("longitude")
        if lat and lng and valid_coord(lat[0], lng[0]):
            return round(_to_float(lat[0]),6), round(_to_float(lng[0]),6), "iframe-q"
        ll = q.get("ll")
        if ll:
            p = ll[0].split(",")
            if len(p)>=2 and valid_coord(p[0], p[1]):
                return round(_to_float(p[0]),6), round(_to_float(p[1]),6), "iframe-ll"
    except: pass
    return None

async def accept_cookies(page):
    labels = ["Súhlas", "Súhlasím", "Prijať", "Akceptujem", "Accept", "I agree", "Prijať všetko"]
    for t in labels:
        try:
            await page.get_by_role("button", name=re.compile(t, re.I)).click(timeout=1200)
            return
        except: pass
    try:
        await page.locator("button:has-text('Súhlas')").first.click(timeout=1200)
    except: pass

async def robust_goto(page, url):
    for attempt in range(2):
        try:
            await page.goto(url, wait_until="domcontentloaded", timeout=35000)
            try: await page.wait_for_load_state("networkidle", timeout=20000)
            except: pass
            return True
        except:
            if attempt == 0:
                await page.wait_for_timeout(700)
                continue
            return False

async def ensure_map_in_view(page):
    for sel in ["text=/^Lokalita$/i", ".leaflet-container", "[data-testid*='map']"]:
        try:
            loc = page.locator(sel).first
            if await loc.count() > 0:
                await loc.scroll_into_view_if_needed(timeout=4000)
                await page.wait_for_timeout(150)
                break
        except: pass
    try:
        await page.wait_for_selector(".leaflet-container", timeout=3000)
    except: pass

async def read_hook_from_frame(frame):
    try:
        data = await frame.evaluate("window.__leafletGps || []")
        if not data: return None
        last = sorted(data, key=lambda d: d.get('t', 0))[-1]
        lat, lng = last.get("lat"), last.get("lng")
        if isinstance(lat,(int,float)) and isinstance(lng,(int,float)) and valid_coord(lat,lng):
            return round(lat,6), round(lng,6), last.get("tag","hook")
    except: pass
    return None

async def get_from_all_frames(page):
    got = await read_hook_from_frame(page.main_frame)
    if got: return got[0], got[1], f"main-{got[2]}"
    for fr in page.frames:
        got = await read_hook_from_frame(fr)
        if got: return got[0], got[1], f"frame-{got[2]}"
    return None

async def iframe_url_fallback(page):
    try:
        for fr in page.frames:
            got = coords_from_url_string(fr.url or "")
            if got: return got
        for el in await page.locator("iframe[src]").all():
            try:
                src = await el.get_attribute("src")
                got = coords_from_url_string(urljoin(page.url, src))
                if got: return got
            except: pass
    except: pass
    return None

def search_obj_for_coords(obj):
    try:
        if isinstance(obj, dict):
            lat = obj.get("lat") or obj.get("latitude")
            lng = obj.get("lng") or obj.get("lon") or obj.get("longitude")
            if valid_coord(lat, lng): return round(_to_float(lat),6), round(_to_float(lng),6)
            coords = obj.get("coordinates")
            if isinstance(coords, (list, tuple)) and len(coords) >= 2:
                if valid_coord(coords[1], coords[0]): return round(_to_float(coords[1]),6), round(_to_float(coords[0]),6)
            for v in obj.values():
                r = search_obj_for_coords(v)
                if r: return r
        elif isinstance(obj, list):
            for v in obj:
                r = search_obj_for_coords(v)
                if r: return r
    except: pass
    return None

async def next_data_fallback(page):
    try:
        node = page.locator("script#__NEXT_DATA__")
        if await node.count() > 0:
            txt = await node.first.text_content()
            if txt:
                data = json.loads(txt)
                r = search_obj_for_coords(data)
                if r: return r[0], r[1], "next-data"
    except: pass
    try:
        ld_nodes = await page.locator("script[type='application/ld+json']").all()
        for n in ld_nodes:
            try:
                t = await n.text_content()
                data = json.loads(t)
                r = search_obj_for_coords(data)
                if r: return r[0], r[1], "json-ld"
            except: pass
    except: pass
    return None

async def regex_page_scan(page):
    try:
        html = await page.content()
        m = LATLNG_RE.search(html)
        if m:
            s = m.group(0).replace(" ", "")
            la, ln = s.split(",")
            lat, lng = _to_float(la), _to_float(ln)
            if valid_coord(lat, lng):
                return round(lat,6), round(lng,6), "regex-html"
    except: pass
    return None

async def nudge_leaflet_wheel(page):
    try:
        cont = page.locator(".leaflet-container").first
        if await cont.count() == 0:
            return False
        await cont.scroll_into_view_if_needed(timeout=3000)
        await page.wait_for_timeout(120)
        box = await cont.bounding_box()
        if not box:
            return False
        cx = box["x"] + box["width"]/2
        cy = box["y"] + box["height"]/2
        await page.mouse.move(cx, cy)
        for _ in range(2):
            await page.mouse.wheel(0, -400)
            await page.wait_for_timeout(120)
        await page.mouse.wheel(0, 260)
        await page.wait_for_timeout(180)
        return True
    except:
        return False

COORD_RE = re.compile(rb'(?:latitude"|lat"\s*|\blat\b)\s*[:=]\s*([-]?\d{1,2}\.\d+).{0,140}?(?:longitude"|lng"|lon"\s*|\blon(g)?\b)\s*[:=]\s*([-]?\d{1,3}\.\d+)', re.I|re.S)

def attach_xhr_sniffer(page):
    sniff = {"lat": None, "lng": None}
    async def collect(resp):
        try:
            ctype = (resp.headers.get("content-type") or "").lower()
            if "json" in ctype or "text" in ctype or ctype == "":
                b = await resp.body()
                m = COORD_RE.search(b)
                if m and sniff["lat"] is None:
                    la = float(m.group(1)); ln = float(m.group(3))
                    if valid_coord(la, ln):
                        sniff["lat"], sniff["lng"] = round(la,6), round(ln,6)
        except: pass
    page.on("response", lambda r: asyncio.create_task(collect(r)))
    return sniff

async def try_in_iframe_page(context, page):
    try:
        frames = await page.locator("iframe[src]").all()
        for fr in frames:
            src = await fr.get_attribute("src")
            if not src: continue
            p2 = await context.new_page()
            try:
                await p2.add_init_script(LEAFLET_HOOK)
            except: pass
            try:
                await p2.goto(src, wait_until="domcontentloaded", timeout=20000)
                try:
                    await p2.wait_for_selector(".leaflet-container", timeout=2000)
                    box = await p2.locator(".leaflet-container").first.bounding_box()
                    if box:
                        await p2.mouse.move(box["x"]+box["width"]/2, box["y"]+box["height"]/2)
                        await p2.mouse.wheel(0, -300)
                        await p2.wait_for_timeout(250)
                except: pass
                for _ in range(12):
                    data = await p2.evaluate("window.__leafletGps && window.__leafletGps[window.__leafletGps.length-1]")
                    if data and isinstance(data, dict) and "lat" in data and "lng" in data:
                        la, ln = float(data["lat"]), float(data["lng"])
                        if valid_coord(la, ln):
                            await p2.close()
                            return round(la,6), round(ln,6), "iframe-page-hook"
                    await p2.wait_for_timeout(200)
            finally:
                try: await p2.close()
                except: pass
    except: pass
    return None

# ---------------- Hlavná GPS rutina pre zadané URL ----------------
async def fetch_gps_for_urls(url_rows):
    """url_rows: list dictov {listing_id, url}"""
    out = []
    async with async_playwright() as pw:
        browser = await pw.chromium.launch(
            headless=HEADLESS,
            args=[
                "--disable-gpu","--disable-webgl","--disable-dev-shm-usage",
                "--no-sandbox","--disable-setuid-sandbox","--disable-features=site-per-process",
            ],
        )
        ctx = await browser.new_context(
            user_agent=("Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                        "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"),
            locale="sk-SK",
            viewport={"width": 1366, "height": 900},
        )

        # blokuj heavy zdroje
        await ctx.route("**/*", lambda route: (
            route.abort() if route.request.resource_type in {"image","media","font"} else route.continue_()
        ))
        await ctx.add_init_script(LEAFLET_HOOK)

        page = await ctx.new_page()

        for i, row in enumerate(url_rows, 1):
            lid, href = row["listing_id"], row["url"]
            ok = await robust_goto(page, href)
            lat=lng=None; src=None
            if ok:
                await accept_cookies(page)
                sniff = attach_xhr_sniffer(page)

                got = await next_data_fallback(page)
                if not got:
                    got = await iframe_url_fallback(page)
                if not got:
                    got = await regex_page_scan(page)

                if not got:
                    await ensure_map_in_view(page)
                    for _ in range(10):
                        got = await get_from_all_frames(page)
                        if got: break
                        if sniff["lat"] is not None:
                            got = (sniff["lat"], sniff["lng"], "xhr-sniffer"); break
                        await page.wait_for_timeout(200)

                    if not got:
                        if await nudge_leaflet_wheel(page):
                            for _ in range(8):
                                got = await get_from_all_frames(page)
                                if got: break
                                if sniff["lat"] is not None:
                                    got = (sniff["lat"], sniff["lng"], "xhr-sniffer"); break
                                await page.wait_for_timeout(200)

                if not got:
                    got = await try_in_iframe_page(ctx, page)

                if got:
                    lat, lng, src = got

            print(f"[{i:04d}/{len(url_rows)}] {lid} -> {lat}, {lng} src={src or 'None'} {'✓' if lat else '×'}")
            out.append({"listing_id": lid, "url": href, "lat": lat, "lng": lng, "source": src or "n/a"})

        try: await page.close()
        except: pass
        try: await browser.close()
        except: pass

    return out

# ---------------- Upsert do gps_dim + denný log ----------------
def upsert_gps_dim_and_log(results_rows, gps_dim_df: pd.DataFrame):
    """results_rows: list dictov {listing_id,url,lat,lng,source}"""
    today = _today_str()
    # denný log
    daily_path = os.path.join(GPS_DAILY_DIR, f"{today}.xlsx")
    daily_df = pd.DataFrame(results_rows, columns=["listing_id","url","lat","lng","source"])
    daily_df["quality"] = daily_df["source"].apply(classify_quality)
    daily_df["success"] = daily_df["lat"].notna() & daily_df["lng"].notna()
    _write_xlsx(daily_df, daily_path)

    # gps_dim upsert
    df = gps_dim_df.copy()
    if df.empty:
        df = pd.DataFrame(columns=["listing_id","url","lat","lng","source","quality","grabbed_at","attempts","last_attempt_at"])

    df.set_index("listing_id", inplace=True, drop=False)

    for r in results_rows:
        lid = str(r["listing_id"])
        url = r.get("url","")
        lat, lng, src = r.get("lat"), r.get("lng"), r.get("source")
        quality = classify_quality(src)

        if lid not in df.index:
            # nový záznam
            df.loc[lid, "listing_id"] = lid
            df.loc[lid, "url"] = url
            df.loc[lid, "attempts"] = 0
            df.loc[lid, "grabbed_at"] = None
            df.loc[lid, "last_attempt_at"] = None

        # vždy aktualizuj URL na poslednú známu
        df.loc[lid, "url"] = url

        # navýš pokus
        prev_attempts = int(df.loc[lid, "attempts"]) if pd.notna(df.loc[lid, "attempts"]) else 0
        df.loc[lid, "attempts"] = prev_attempts + 1
        df.loc[lid, "last_attempt_at"] = today

        if pd.notna(lat) and pd.notna(lng):
            # ak už mal GPS, vylepšuj iba ak je kvalita lepšia
            had_lat = pd.notna(df.loc[lid, "lat"]) and pd.notna(df.loc[lid, "lng"])
            if not had_lat:
                # prvé GPS
                df.loc[lid, "lat"] = float(lat)
                df.loc[lid, "lng"] = float(lng)
                df.loc[lid, "source"] = src
                df.loc[lid, "quality"] = quality
                df.loc[lid, "grabbed_at"] = today
            else:
                # porovnaj kvalitu
                old_q = str(df.loc[lid, "quality"] or "")
                better = False
                rank = {"unknown":0,"approx_center":1,"approx_circle":2,"exact_url":3,"exact_setview":4,"exact_api":5,"exact_marker":6}
                if rank.get(quality,0) > rank.get(old_q,0):
                    better = True
                if better:
                    df.loc[lid, "lat"] = float(lat)
                    df.loc[lid, "lng"] = float(lng)
                    df.loc[lid, "source"] = src
                    df.loc[lid, "quality"] = quality
                    df.loc[lid, "grabbed_at"] = today
                # ak kvalita nie je lepšia, nič nemeníme (ponecháme lepší historický bod)

    df_out = df.reset_index(drop=True)[["listing_id","url","lat","lng","source","quality","grabbed_at","attempts","last_attempt_at"]]
    _write_xlsx(df_out, GPS_DIM_PATH)
    return daily_path

# ---------------- Orchestrátor ----------------
async def main():
    work, gps_dim_df, used_fact = prepare_work_from_fact_and_gps()

    print(f"FACT zdroj: {used_fact}")
    print(f"Dnes treba stiahnuť GPS pre {len(work)} inzerátov (NEW/RETRY/REVALIDÁCIE).")

    if not work:
        # nič na práci – aj tak nech je prázdny denný log
        daily_path = os.path.join(GPS_DAILY_DIR, f"{_today_str()}.xlsx")
        if not os.path.exists(daily_path):
            _write_xlsx(pd.DataFrame(columns=["listing_id","url","lat","lng","source","quality","success"]), daily_path)
        print(f"✅ Hotovo (nebolo čo sťahovať). Denník: {daily_path}")
        return

    results = await fetch_gps_for_urls(work)
    daily_path = upsert_gps_dim_and_log(results, gps_dim_df)

    ok_cnt = sum(1 for r in results if r["lat"] is not None and r["lng"] is not None)
    print(f"\n✅ Hotovo. Uložené:")
    print(f"  • gps_dim: {GPS_DIM_PATH}")
    print(f"  • gps_daily_log: {daily_path}")
    print(f"  • uspesnych: {ok_cnt}/{len(results)}")

# --- ŠTART ---
try:
    loop = asyncio.get_running_loop()
    loop.run_until_complete(main())
except RuntimeError:
    asyncio.run(main())
